# Default settings written to localStorage on first load.
# Users can still change these at runtime via the Settings page.
# Leave a value empty (or omit the line) to fall back to the built-in default.

# Default Solana RPC endpoint.
DEFAULT_RPC_URL=https://api.mainnet-beta.solana.com

# Default Squads V4 program ID. If empty, falls back to multisig.PROGRAM_ID from @sqds/multisig.
DEFAULT_PROGRAM_ID=

# Default block explorer URL.
DEFAULT_EXPLORER_URL=https://explorer.solana.com

# Default multisig address loaded on first visit (no default).
DEFAULT_MULTISIG_ADDRESS=

# Shared password for the soft frontend auth gate.
# Leave empty (or omit) to disable the gate and render the app normally.
# WARNING: this value is embedded in the client bundle and trivially recoverable
# from devtools/network. It is a soft deterrent, not real authentication.
FRONTEND_AUTH_SECRET=
